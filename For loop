  public void paintAndMove(String[] paintColors) {
    for (int index = 0; index < paintColors.length; index++) {
      paintIfHasPaint(paintColors[index]);
      moveIfCanMove();
    }
  }

  public void moveTimes(int numSteps) {
    for (int steps = 0; steps < numSteps; steps++) {
      if (canMove()) {
        move();
      }
    }
  }
