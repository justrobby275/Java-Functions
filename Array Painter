import org.code.neighborhood.*;

public class NeighborhoodRunner {
  public static void main(String[] args) {

    String[] paintColors = {"red", "blue", "yellow", "green", "purple","black"};
    ArrayPainter sara = new ArrayPainter(1, 0, "south", 10, paintColors);

    System.out.println(sara);
    
    sara.paintColors();
  }
}

