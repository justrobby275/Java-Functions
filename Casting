//rounds double to int
double num = 1.5;
System.out.println((int) num + 0.5)

//better version
double x = -1.9;

if (x >= 0) {
    x = (int) (x + 0.5);
System.out.println(x);
} else {
    x = (int) (x - 0.5);
System.out.println(x);
}


