//Reverse 1d Array
  public void reverseResponses() {
    
    //loop till midpoint
    for (int index = 0; index < responses.length / 2; index++) {
      
      //Save First
      Respondent temp = responses[index];
      
      //Find the back element
      int backIndex = responses.length - 1 - index;
      
      //move the back element to the front
      responses[index] = responses[backIndex];
      
      // 4. Move front to back
      responses[backIndex] = temp;
    }
  }


    responses.reverseResponses();
    System.out.println(responses);
