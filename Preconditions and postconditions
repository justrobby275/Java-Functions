public class DataRunner {
  public static void main(String[] args) {

    Channel tedTalks = new Channel("TED", "titles.txt", "durations.txt", "views.txt");

    tedTalks.run();
    
    System.out.println(tedTalks.getVideoInfo(10)); 
  }
